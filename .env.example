# ─── Clinic Queue System — Environment Variables ─────────────────────────────

# JWT signing secret — CHANGE THIS to a long, random string in production!
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-key-change-this-in-production

# Optional: override the default port (Next.js default is 3000)
# PORT=3000

# ─── First platform admin (super admin) — used by `npm run seed` ─────────────
# Both are required for the super admin to be created. There is no default
# password. If the admin already exists the seed leaves it unchanged.
# SUPER_ADMIN_EMAIL=owner@yourcompany.com
# SUPER_ADMIN_PASSWORD=Use-A-Long-Strong-Passw0rd!
# SUPER_ADMIN_NAME=Super Admin

# ─── Demo clinic doctors — used by `npm run seed` ────────────────────────────
# Defaults are for local development only. Do NOT run the seed in production
# with the defaults: they are publicly known.
# SEED_DOCTOR_EMAIL=doctor@clinic.com
# SEED_DOCTOR_PASSWORD=ChangeMe123!
