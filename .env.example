# ─── Clinic Queue System — Environment Variables ─────────────────────────────

# JWT signing secret — CHANGE THIS to a long, random string in production!
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-key-change-this-in-production

# Optional: override the default port (Next.js default is 3000)
# PORT=3000
