generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DOCTOR
  RECEPTIONIST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum WaitingScreenMode {
  NUMBERS // public screen shows queue numbers only
  NAMES   // public screen also shows masked patient names (e.g. "Ahmed M.")
}

enum QueueStatus {
  WAITING
  IN_PROGRESS
  SERVED
  CANCELLED
}

model Clinic {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings     ClinicSettings?
  users        User[]
  doctors      Doctor[]
  patients     Patient[]
  appointments Appointment[]
  visits       Visit[]
  queueEntries QueueEntry[]

  @@map("clinics")
}

model ClinicSettings {
  id                  String   @id @default(uuid())
  clinicId            String   @unique
  workingHours        Json     @default("{}")
  maxPatientsPerDay   Int      @default(50)
  appointmentDuration Int      @default(30)
  gracePeriod         Int      @default(15)
  delayThreshold      Int      @default(20)
  waitingScreenMode   WaitingScreenMode @default(NUMBERS)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("clinic_settings")
}

model User {
  id           String    @id @default(uuid())
  clinicId     String
  email        String
  passwordHash String
  fullName     String
  role         Role      @default(RECEPTIONIST)
  isActive     Boolean   @default(true)
  // Bumped on logout-all, password change and deactivation: every access token
  // issued before the bump (it carries the old value) is rejected immediately.
  tokenVersion Int       @default(0)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clinic Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor Doctor?
  refreshTokens RefreshToken[]

  patientsCreated     Patient[]     @relation("PatientCreatedBy")
  patientsUpdated     Patient[]     @relation("PatientUpdatedBy")
  appointmentsCreated Appointment[] @relation("AppointmentCreatedBy")
  appointmentsUpdated Appointment[] @relation("AppointmentUpdatedBy")
  visitsCreated       Visit[]       @relation("VisitCreatedBy")
  visitsUpdated       Visit[]       @relation("VisitUpdatedBy")
  queueEntriesCreated QueueEntry[]  @relation("QueueEntryCreatedBy")
  queueEntriesUpdated QueueEntry[]  @relation("QueueEntryUpdatedBy")

  @@unique([clinicId, email])
  @@index([clinicId])
  @@map("users")
}

// One row per issued refresh token. The row id is the token's `jti` claim, so a
// token can be revoked server-side (logout) and rotated on every refresh.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  expiresAt    DateTime
  revokedAt    DateTime?
  // set when this token was rotated into a new one (used to detect token reuse)
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Doctor {
  id                  String   @id @default(uuid())
  clinicId            String
  userId              String   @unique
  specialty           String
  bio                 String?
  // Optional per-doctor overrides — fall back to ClinicSettings when null
  appointmentDuration Int?
  workingHours        Json?
  // false = hidden from online booking (staff can still book)
  isBookable          Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  queueEntries QueueEntry[]
  visits       Visit[]

  @@index([clinicId, isBookable])
  @@map("doctors")
}

model Patient {
  id          String    @id @default(uuid())
  clinicId    String
  createdById String?
  updatedById String?
  mrn         String
  fullName    String
  phone       String
  dateOfBirth DateTime  @db.Date
  gender      Gender
  address     String?
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("PatientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?         @relation("PatientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  appointments Appointment[]
  visits       Visit[]

  @@unique([clinicId, mrn])
  @@unique([clinicId, phone])
  @@index([clinicId, deletedAt])
  @@index([clinicId, fullName])
  @@map("patients")
}

model Appointment {
  id              String            @id @default(uuid())
  clinicId        String
  patientId       String
  // Nullable only for legacy rows; every new appointment requires a doctor
  doctorId        String?
  createdById     String?
  updatedById     String?
  visitId         String?           @unique
  appointmentDate DateTime          @db.Date
  appointmentTime DateTime          @db.Time
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  clinic    Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor    Doctor? @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdBy User?   @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("AppointmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  visit     Visit?  @relation(fields: [visitId], references: [id], onDelete: SetNull)

// NOTE: The uniqueness constraint for active appointments (SCHEDULED, CONFIRMED)
// is enforced per DOCTOR by a partial unique index managed manually in migrations:
//   (doctorId, appointmentDate, appointmentTime) WHERE status IN (...)
// Do NOT add a Prisma @@unique for it here.
  @@index([doctorId, appointmentDate])
  @@index([clinicId, appointmentDate, appointmentTime])
  @@index([clinicId, appointmentDate])
  @@index([patientId, appointmentDate])
  @@index([clinicId, status])
  @@map("appointments")
}

model Visit {
  id             String    @id @default(uuid())
  clinicId       String
  patientId      String
  // Nullable only for legacy rows; the doctor who owns this visit
  doctorId       String?
  createdById    String?
  updatedById    String?
  visitDate      DateTime  @db.Date
  chiefComplaint String?
  diagnosis      String?
  treatment      String?
  prescription   String?
  notes          String?
  startedAt      DateTime?
  completedAt    DateTime?
  followUpDate   DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor      Doctor?      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdBy   User?        @relation("VisitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?        @relation("VisitUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  appointment Appointment?
  queueEntry  QueueEntry?

  // A patient may see several doctors on the same day, but only once per doctor
  @@unique([patientId, visitDate, doctorId])
  @@index([doctorId, visitDate])
  @@index([clinicId, visitDate])
  @@index([patientId])
  @@map("visits")
}

model QueueEntry {
  id          String      @id @default(uuid())
  clinicId    String
  visitId     String?     @unique
  // Each doctor has their own queue. Nullable only for legacy rows.
  doctorId    String?
  createdById String?
  updatedById String?
  queueDate   DateTime    @db.Date
  queueNumber Int
  isReserved  Boolean     @default(false)
  reservedFor String?
  status      QueueStatus @default(WAITING)
  checkedInAt DateTime?
  calledAt    DateTime?
  startedAt   DateTime?
  servedAt    DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  clinic    Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  visit     Visit? @relation(fields: [visitId], references: [id], onDelete: SetNull)
  doctor    Doctor? @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("QueueEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?  @relation("QueueEntryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // Queue numbers are unique PER DOCTOR per day
  @@unique([doctorId, queueDate, queueNumber])
  @@index([doctorId, queueDate, status])
  @@index([clinicId, queueDate, status])
  @@index([clinicId, queueDate])
  @@map("queue_entries")
}